[node name="CutsceneActionCamera" type="Node2D" parent="AreaTrigger/DialogInteraction/DialogCutscene_MOVE2"]
position = Vector2(366, 111)
script = ExtResource("11_6ays4")
metadata/_custom_type_script = "uid://cgv82amncyx68"

[node name="DialogText2" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "
Sí... ya veo..."
npc_info = ExtResource("18_1gg17")

[node name="DialogText3" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "En efecto, hay poder dentro de ti...
Siento el Aether recorriendo tus venas."
npc_info = ExtResource("18_1gg17")

[node name="DialogText4" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "
¿Has prestado el juramento del guerrero?"
npc_info = ExtResource("18_1gg17")

[node name="DialogText5" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "Debe ser por esta misteriosa espada, la encontré en una cueva antes. "
npc_info = ExtResource("12_hvxrb")

[node name="DialogText6" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "[shake]¡Por los pelos de la cuca de mi abuela![/shake]
Esa es la espada legendaria capaz de acabar con el mal."
npc_info = ExtResource("18_1gg17")

[node name="DialogText7" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "
¿La espada legendaria?"
npc_info = ExtResource("12_hvxrb")

[node name="DialogText8" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "Si, se dice que es capaz de otorgar un poder sin igual a quien elige."
npc_info = ExtResource("18_1gg17")

[node name="DialogText9" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "¿Poder? ¿Como puedes probar eso? Me siento normal."
npc_info = ExtResource("12_hvxrb")

[node name="DialogText10" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "Tal vez, si pudieras enviar esta olla por encima de esas colinas. Semejante hazaña demostraría que eres el elegido."
npc_info = ExtResource("18_1gg17")

[node name="DialogText11" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "Lo intentaré, pero no prometo nada."
npc_info = ExtResource("12_hvxrb")

