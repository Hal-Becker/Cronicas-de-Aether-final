[node name="DialogText" type="Node" parent="AreaTrigger/DialogInteraction"]
script = ExtResource("9_bchre")
text = "Tú, joven héroe. Ven aquí,
y déjame mirarte a los ojos..."
npc_info = ExtResource("18_1gg17")

[node name="DialogCutscene_MOVE2" type="Node" parent="AreaTrigger/DialogInteraction"]
